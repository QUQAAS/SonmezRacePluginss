<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Workflow, bu degeri AssettoServer.csproj'daki TargetFramework ile otomatik esitler (pre44: net11.0) -->
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SonmezRacePlugin</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bu klasor AssettoServer deposunun icinde, AssettoServer/ klasorunun yaninda durmali.
         GitHub Actions (.github/workflows/build.yml) bunu otomatik yapar. -->
    <ProjectReference Include="..\AssettoServer\AssettoServer.csproj" Private="false" ExcludeAssets="runtime" />
    <!-- pre44: CarStatus, IOutgoingNetworkPacket vb. AssettoServer.Shared icinde, ayri referans gerekli -->
    <ProjectReference Include="..\AssettoServer.Shared\AssettoServer.Shared.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="lua\sonmezrace.lua" LogicalName="sonmezrace.lua" />
  </ItemGroup>

  <!-- Opsiyonel /yaris komutu: dotnet build -p:WithCommands=true -->
  <ItemGroup Condition="'$(WithCommands)' == 'true'">
    <Compile Include="Commands.cs.optional" />
  </ItemGroup>

</Project>
